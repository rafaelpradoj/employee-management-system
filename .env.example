# --- Configuração Local (Sem Docker) ---
# Se for rodar localmente, altere os valores abaixo:
DB_USER=postgres
DB_PASS=sua_senha_aqui
DB_NAME=empresa
DB_HOST=localhost
DB_PORT=5432

# --- Configuração Docker (Opcional) ---
# Se preferir usar a string de conexão completa, descomente a linha abaixo.
# No Docker, o host deve ser "db" e o usuário/senha devem bater com o docker-compose.
# DB_CONFIG="dbname=empresa user=rafael_dev password=senha123 host=db port=5432"